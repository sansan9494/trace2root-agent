APP_NAME=Trace2Root Agent
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/trace2root.db
VECTOR_DB_URI=./data/milvus_bge.db
UPLOAD_DIR=./data/uploads
MODEL_CACHE_DIR=./data/model_cache
MODEL_LOCAL_FILES_ONLY=true
MODEL_WARMUP=true

# ollama | deterministic。Ollama 未安装时 deterministic 可离线运行。
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=60

# sentence_transformers | hashing。默认使用本地 BGE，小模型在 CPU 运行。
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=512
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=4

CHAT_MAX_ITERATIONS=8
OPS_MAX_ITERATIONS=12
TOOL_TIMEOUT_SECONDS=30
TASK_TIMEOUT_SECONDS=600
MEMORY_RECENT_MESSAGES=8
MEMORY_SUMMARY_THRESHOLD=12
MEMORY_RECALL_MESSAGES=3
RAG_TOP_K=12
RAG_TOP_N=5
# hybrid 使用向量召回 + 中文 BM25 + RRF + Cross-Encoder；vector 用于基线对比。
RAG_RETRIEVAL_MODE=hybrid
RAG_CANDIDATE_POOL=256
RAG_RRF_K=60
RAG_BM25_K1=1.5
RAG_BM25_B=0.75
RAG_MAX_CHUNKS_PER_DOCUMENT=2
MAX_UPLOAD_MB=10

# 真实 MCP stdio Server；启动时 list_tools，调用时 call_tool。
MCP_SERVERS=[{"name":"mock-ops","command":".venv/bin/python","args":["mock_services/mcp_server.py"],"cwd":"."}]
MOCK_NOTIFICATION_ALLOWLIST=trace2root-demo
